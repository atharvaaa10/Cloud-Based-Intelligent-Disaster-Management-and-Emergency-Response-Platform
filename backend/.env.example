# ── ResQCloud Backend Environment Configuration ───────────────────────

# Environment: development | production | test
ENV=development

# Feature flag: when true, uses real boto3 calls for S3/SQS/SNS; when false, uses local mock stubs
USE_AWS=false

# Database: PostgreSQL (with Docker Compose, local PostgreSQL, or Amazon RDS)
# PostgreSQL Async Connection URL:
DATABASE_URL=postgresql+asyncpg://disaster_user:disaster_pass@localhost:5432/disaster_db

# Alternative SQLite connection URL for standalone local evaluation:
# DATABASE_URL=sqlite+aiosqlite:///./disaster.db

# JWT settings (Use a strong cryptographically random secret in production)
SECRET_KEY=local-dev-secret-key-change-in-production-resqcloud
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (comma-separated allowed origins for frontend communication)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS Settings (used when USE_AWS=true or deployed on AWS EC2)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
SQS_QUEUE_URL=
SNS_TOPIC_ARN=

# Internal Token for secure Lambda-to-FastAPI triage webhook
INTERNAL_TOKEN=dev-internal-triage-token-change-in-prod
