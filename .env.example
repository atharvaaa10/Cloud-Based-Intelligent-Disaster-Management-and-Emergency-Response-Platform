# Environment: development | production | test
ENV=development

# Feature flag: when true, uses real boto3 calls for S3; when false, uses local mock stubs
USE_AWS=false

# Database: PostgreSQL (with docker compose) or SQLite for quick local run
DATABASE_URL=postgresql+asyncpg://disaster_user:disaster_pass@localhost:5432/disaster_db
# For SQLite: DATABASE_URL=sqlite+aiosqlite:///./disaster.db

# JWT (must be changed to a secure random string in production)
SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS Settings (used when USE_AWS=true or deployed on EC2)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
SQS_QUEUE_URL=
SNS_TOPIC_ARN=
